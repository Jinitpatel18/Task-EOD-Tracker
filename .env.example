# MongoDB Connection URL
# Replace with your MongoDB Atlas URI or local MongoDB instance
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/task_tracker?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/task_tracker_db
MONGODB_URI=mongodb://127.0.0.1:27017/task_tracker_db

# JWT Secret for Session Authentication
JWT_SECRET=super_secret_eod_tracker_jwt_key_2026_xyz987654321

# App URL
NEXT_PUBLIC_APP_NAME="Team Task & EOD Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

